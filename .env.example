# ---------------------------------------------------------------------------
# DesignSync AI — environment configuration
#
# Copy to `.env` and adjust. Every value below has a working default, so the
# application runs end-to-end with an EMPTY .env and no API keys at all.
# ---------------------------------------------------------------------------

# --- LLM provider selection -----------------------------------------------

# Which provider serves the agents:
#
#   vertex     Google Vertex AI (Gemini)  — Application Default Credentials
#   anthropic  Anthropic (Claude)         — ANTHROPIC_API_KEY
#   openai     OpenAI (GPT)               — OPENAI_API_KEY
#   mock       deterministic, offline     — no credentials
#
# A provider is used only if it reports itself CONFIGURED; otherwise the request
# falls back to the mock. That is why a fresh clone runs offline with an empty
# .env even though the default below is Vertex AI.
#
# "Configured" is not "credentials valid" — a wrong key or an expired ADC
# session fails loudly at call time as a recorded agent failure, rather than
# silently returning a fabricated answer.
LLM_PROVIDER=vertex

# Force the mock regardless of LLM_PROVIDER. The UI's "Mock LLM" toggle sets
# this per analysis; this is the global default for that toggle.
MOCK_LLM=false

# --- Google Vertex AI (default provider) ----------------------------------

# NO API KEY. Vertex AI uses Application Default Credentials. Locally:
#     gcloud auth application-default login
#     gcloud config set project <your-project-id>
# On Google Cloud, the attached service account / metadata server supplies them.
#
# Setting the project is what marks this provider configured.
# GOOGLE_CLOUD_PROJECT=my-gcp-project
GOOGLE_CLOUD_LOCATION=global

# gemini-3.6-flash — $1.50 / $7.50 per MTok
VERTEX_MODEL=gemini-3.6-flash

# --- Anthropic -------------------------------------------------------------

# ANTHROPIC_API_KEY=sk-ant-...

#   claude-opus-5     $5 / $25 per MTok   (most capable)
#   claude-sonnet-5   $3 / $15 per MTok
#   claude-haiku-4-5  $1 / $5  per MTok   (cheapest)
LLM_MODEL=claude-opus-5

# --- OpenAI ----------------------------------------------------------------

# OPENAI_API_KEY=sk-...

#   gpt-5.6-sol    $5.00 / $30.00 per MTok  (frontier; `gpt-5.6` is an alias)
#   gpt-5.6-terra  mid tier                 (default — balances cost and quality)
#   gpt-5.6-luna   $0.20 / $1.20 per MTok   (high volume)
OPENAI_MODEL=gpt-5.6-terra

# --- Execution ------------------------------------------------------------

# Max concurrent LLM requests inside one analysis run. Prevents unbounded
# fan-out. Set to 1 to watch the "parallel" agents serialise.
DEFAULT_CONCURRENCY_LIMIT=3

# Multiplier applied to the mock provider's simulated latency.
# 1.0 = demo speed (planner 1.0s, code 2.5s, docs 2.0s, dep 2.2s, reviewer 1.2s)
# 0.1 = fast enough for the test suite while overlap stays measurable
MOCK_LATENCY_SCALE=1.0

# --- Persistence ----------------------------------------------------------

# SQLite by default. On Railway the container filesystem is ephemeral: mount a
# volume at /data and use sqlite:////data/designsync.db to survive redeploys.
DATABASE_URL=sqlite:///./designsync.db

# --- HTTP -----------------------------------------------------------------

# Comma-separated origins allowed by CORS. Only needed in local dev, where the
# Vite dev server runs on a different port. In the Docker/Railway deploy the
# frontend is served from the same origin, so CORS is irrelevant.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploaded repositories are extracted here. Treated as untrusted text: parsed
# with `ast`, never imported and never executed.
UPLOAD_DIR=./data/uploads
