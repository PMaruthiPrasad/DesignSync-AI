# Build context hygiene — keeps the image small and avoids leaking local state.

.git/
.gitignore

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Node — reinstalled inside the build stage
frontend/node_modules/
frontend/dist/

# Local data and secrets
.env
.env.local
*.db
*.sqlite3
data/
backend/data/
backend/*.db

# Docs / editor
README.md
.vscode/
.idea/
.DS_Store
